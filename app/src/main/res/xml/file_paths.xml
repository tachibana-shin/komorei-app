<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths for the Logs share sheet and the OTA updater. The updater
  writes a verified APK only to cache/updates and grants read access to the
  system package installer through the provider URI.
-->
<paths>
    <cache-path
        name="logs"
        path="logs/" />
    <cache-path
        name="updates"
        path="updates/" />
</paths>
