<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 27+ adds the light-navigation-bar appearance flag. Explicitly keep both
         system bar appearances "dark" (light icons) to match the dark theme. -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>