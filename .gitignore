.idea
.gradle/
.kotlin/
build
node_modules/
local.properties
/gradle/gradle-daemon-jvm.properties

# Signing keys
*.jks
*.keystore

# OAuth client downloads (keep client credentials out of the repository)
client_secret_*.json
google-services.json

# Local secrets consumed by the Secrets Gradle Plugin (`secrets { }` in
# app/build.gradle.kts). Commit `.env.example` instead — the plugin falls back to
# it, so builds work without a local `.env`. Currently a single `API_KEY`
# placeholder for the planned Gemini feature; nothing reads it yet.
.env
.env.local
!.env.example

# Rust runner build output (symlinked to /mnt/komorei-data/komorei-builds/)
runner/target/
app/src/main/jniLibs

# komorei-sdk is a SEPARATE git repository (reached by relative path from
# runner/Cargo.toml); never commit it into the app repo.
komorei-sdk/

# The sources collection is a SEPARATE git repository too (like komorei-sdk/):
# reached by relative path from app/build.gradle.kts and the JVM integration
# tests. Never commit it into the app repo. Build/publish it from inside
# `sources/` with `komorei repo build`.
sources/
Aidoku/
